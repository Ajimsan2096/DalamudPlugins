<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <Version>1.14.0.0</Version>
    <Description>Real-time chat translation (DeepL / Google) between two languages, e.g. English and French.</Description>
    <PackageProjectUrl>https://github.com/Ajimsan2096/DalamudPlugins</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization\*.json" LogicalName="LinguaBridge.Localization.%(Filename).json" />
  </ItemGroup>
</Project>
